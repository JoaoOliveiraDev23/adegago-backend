{
  "name": "adegago-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Infraestrutura Firebase do AdegaGo: regras de segurança do Firestore, configuração de hosting/emuladores, testes e scripts.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-adegago",
    "emuladores:dados": "node scripts/preparar-emulador.mjs",
    "preview:hosting": "firebase emulators:start --only hosting --project demo-adegago",
    "test": "firebase emulators:exec --only firestore --project demo-adegago \"node --test tests/regras.test.js\"",
    "deploy:regras": "firebase deploy --only firestore:rules",
    "deploy": "firebase deploy --only firestore:rules,hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.35.0"
  }
}
